{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketcaddy",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-02-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
